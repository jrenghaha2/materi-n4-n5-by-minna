rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security & RBAC Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Permanent Bootstrap Superadmin check (requires verified email)
    function isBootstrapSuperAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'jrenghaha2@gmail.com';
    }

    function isTargetBootstrapSuperAdmin(data) {
      return 'email' in data
        && data.email is string
        && data.email.lower() == 'jrenghaha2@gmail.com';
    }

    function hasStoredUserRole(expectedRole) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == expectedRole;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || hasStoredUserRole('superadmin');
    }

    function isAdminOrAbove() {
      return isSuperAdmin() || hasStoredUserRole('admin');
    }

    function matchesActualUserRole(role, userId) {
      return (isBootstrapSuperAdmin() && role == 'superadmin')
        || (
          exists(/databases/$(database)/documents/users/$(userId))
          && (
            ('role' in get(/databases/$(database)/documents/users/$(userId)).data
              && get(/databases/$(database)/documents/users/$(userId)).data.role == role)
            || (!('role' in get(/databases/$(database)/documents/users/$(userId)).data) && role == 'user')
          )
        );
    }

    function isValidRole(role) {
      return role is string && role in ['user', 'admin', 'superadmin'];
    }

    function isValidBookId(bookId) {
      return bookId is string && bookId in ['n5', 'n4'];
    }

    function isValidDisplayName(data) {
      return !('displayName' in data)
        || (data.displayName is string && data.displayName.size() <= 60);
    }

    function isValidEmailField(data) {
      return !('email' in data)
        || (data.email is string && data.email.size() <= 120);
    }

    function isValidAvatarUrl(data) {
      return !('avatarUrl' in data)
        || (data.avatarUrl is string
          && data.avatarUrl.size() <= 20000
          && (data.avatarUrl.size() == 0
            || data.avatarUrl.matches('^https://[^\\s]+$')
            || data.avatarUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    function isValidRoleField(data) {
      return !('role' in data) || isValidRole(data.role);
    }

    function isOwnAuthEmail(data) {
      return (
          request.auth.token.email is string
          && request.auth.token.email.size() > 0
          && 'email' in data
          && data.email is string
          && data.email.lower() == request.auth.token.email.lower()
        )
        || (
          (!(request.auth.token.email is string) || request.auth.token.email.size() == 0)
          && (!('email' in data) || data.email == '')
        );
    }

    function isValidAnyBunpouPatternId(val) {
      return val is string
        && val.size() >= 10
        && val.size() <= 32
        && val.matches('^(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?$');
    }

    function isValidOptionalBunpouPatternId(val) {
      return val is string && (val == '' || isValidAnyBunpouPatternId(val));
    }

    // Full-array dual-separator validation for up to 4 live quiz choice pattern IDs
    function isValidLiveQuizChoiceIds(arr) {
      return arr is list
        && arr.size() <= 4
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].size() >= 10
            && arr[0].size() <= 32
            && arr.join(',').size() <= 140
            && arr.join(',').matches('^(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?(,(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?(\\|(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?)*$')
          )
        );
    }

    // Full-array dual-separator validation for running live quiz answers (up to 50 items):
    // Format per element: questionNo:modeCode:patternId:isCorrectBit:selectedPatternId:exampleIndex
    function isValidLiveQuizAnswers(arr) {
      return arr is list
        && arr.size() <= 50
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].size() >= 25
            && arr[0].size() <= 80
            && arr[0].matches('^[1-9][0-9]?:[0-2]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[01]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[0-3]$')
            && arr.join(';').size() <= 4000
            && arr.join(';').matches('^[1-9][0-9]?:[0-2]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[01]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[0-3](;[1-9][0-9]?:[0-2]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[01]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[0-3])*$')
            && arr.join('#').matches('^[1-9][0-9]?:[0-2]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[01]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[0-3](#[1-9][0-9]?:[0-2]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[01]:(n5|n4)-bab-[1-9][0-9]?-p[1-9][0-9]?:[0-3])*$')
          )
        );
    }

    function isValidLiveQuizDetailFields(data) {
      return (!('quizFromChapter' in data)
          || (data.quizFromChapter is int && data.quizFromChapter >= 0 && data.quizFromChapter <= 50))
        && (!('quizToChapter' in data)
          || (data.quizToChapter is int && data.quizToChapter >= 0 && data.quizToChapter <= 50))
        && (!('quizPatternId' in data)
          || isValidOptionalBunpouPatternId(data.quizPatternId))
        && (!('quizExampleIndex' in data)
          || (data.quizExampleIndex is int && data.quizExampleIndex >= 0 && data.quizExampleIndex <= 3))
        && (!('quizChoiceIds' in data)
          || isValidLiveQuizChoiceIds(data.quizChoiceIds))
        && (!('quizSelectedChoiceId' in data)
          || isValidOptionalBunpouPatternId(data.quizSelectedChoiceId))
        && (!('quizAnswerCorrect' in data)
          || (data.quizAnswerCorrect is int && data.quizAnswerCorrect in [-1, 0, 1]))
        && (!('quizLiveAnswers' in data)
          || isValidLiveQuizAnswers(data.quizLiveAnswers));
    }

    // Full-array validation without loops using dual-separator join (',' and '|'):
    // Enforces list type, max size (<= 150), uniqueness (toSet), and exact per-book Bunpou pattern ID format.
    function isValidN5List(arr) {
      return arr is list
        && arr.size() <= 150
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?$')
            && arr.join(',').size() <= 4000
            && arr.join(',').matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?(,n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?(\\|n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?)*$')
          )
        );
    }

    function isValidN4List(arr) {
      return arr is list
        && arr.size() <= 150
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?$')
            && arr.join(',').size() <= 4000
            && arr.join(',').matches('^n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?(,n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?(\\|n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?)*$')
          )
        );
    }

    function isValidBunpouList(arr, bookId) {
      return (bookId == 'n5' && isValidN5List(arr))
        || (bookId == 'n4' && isValidN4List(arr));
    }

    // Full-array validation for Kotoba vocabulary word IDs (851 N5 words, 430 N4 words)
    function isValidN5KotobaList(arr) {
      return arr is list
        && arr.size() <= 1000
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-w[1-9][0-9]{0,2}$')
            && arr.join(',').size() <= 20000
            && arr.join(',').matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-w[1-9][0-9]{0,2}(,n5-bab-([1-9]|1[0-9]|2[0-5])-w[1-9][0-9]{0,2})*$')
            && arr.join('|').matches('^n5-bab-([1-9]|1[0-9]|2[0-5])-w[1-9][0-9]{0,2}(\\|n5-bab-([1-9]|1[0-9]|2[0-5])-w[1-9][0-9]{0,2})*$')
          )
        );
    }

    function isValidN4KotobaList(arr) {
      return arr is list
        && arr.size() <= 1000
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^n4-bab-(2[6-9]|[34][0-9]|50)-w[1-9][0-9]{0,2}$')
            && arr.join(',').size() <= 20000
            && arr.join(',').matches('^n4-bab-(2[6-9]|[34][0-9]|50)-w[1-9][0-9]{0,2}(,n4-bab-(2[6-9]|[34][0-9]|50)-w[1-9][0-9]{0,2})*$')
            && arr.join('|').matches('^n4-bab-(2[6-9]|[34][0-9]|50)-w[1-9][0-9]{0,2}(\\|n4-bab-(2[6-9]|[34][0-9]|50)-w[1-9][0-9]{0,2})*$')
          )
        );
    }

    function isValidKotobaList(arr, bookId) {
      return (bookId == 'n5' && isValidN5KotobaList(arr))
        || (bookId == 'n4' && isValidN4KotobaList(arr));
    }

    // Full-array validation for compact pure-ASCII daily tracker tokens (up to 90 days):
    // Format per element: YYYY-MM-DD|quizSessions|id1,id2,...
    function isValidDailyDaysList(arr) {
      return arr is list
        && arr.size() <= 90
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].size() >= 13
            && arr[0].size() <= 8000
            && arr[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,3}\\|(|(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2}(,(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2})*)$')
            && arr.join(';').size() <= 60000
            && arr.join(';').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,3}\\|(|(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2}(,(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2})*)(;[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,3}\\|(|(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2}(,(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2})*))*$')
            && arr.join('#').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,3}\\|(|(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2}(,(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2})*)(#[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,3}\\|(|(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2}(,(n5|n4)-bab-[1-9][0-9]?-[pw][1-9][0-9]{0,2})*))*$')
          )
        );
    }

    // Compact pure-ASCII quiz session token validation (per-book chapter range & patternId prefix enforced)
    function isValidN5QuizToken(val) {
      return val is string
        && val.size() >= 24
        && val.size() <= 8000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(mixed|cloze|formula|function)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(all|([1-9]|1[0-9]|2[0-5])(\\.([1-9]|1[0-9]|2[0-5]))*)\\|(|[1-9][0-9]{0,2}:[0-2]:n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?:[01](:n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?:[0-3])?(;[1-9][0-9]{0,2}:[0-2]:n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?:[01](:n5-bab-([1-9]|1[0-9]|2[0-5])-p[1-9][0-9]?:[0-3])?)*)$');
    }

    function isValidN4QuizToken(val) {
      return val is string
        && val.size() >= 24
        && val.size() <= 8000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(mixed|cloze|formula|function)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(all|(2[6-9]|[34][0-9]|50)(\\.(2[6-9]|[34][0-9]|50))*)\\|(|[1-9][0-9]{0,2}:[0-2]:n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?:[01](:n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?:[0-3])?(;[1-9][0-9]{0,2}:[0-2]:n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?:[01](:n4-bab-(2[6-9]|[34][0-9]|50)-p[1-9][0-9]?:[0-3])?)*)$');
    }

    function isValidQuizSessionToken(val, bookId) {
      return (bookId == 'n5' && isValidN5QuizToken(val))
        || (bookId == 'n4' && isValidN4QuizToken(val));
    }

    function isValidQuizHistoryBatchA(arr, bookId) {
      return (arr.size() <= 0 || isValidQuizSessionToken(arr[0], bookId))
        && (arr.size() <= 1 || isValidQuizSessionToken(arr[1], bookId))
        && (arr.size() <= 2 || isValidQuizSessionToken(arr[2], bookId))
        && (arr.size() <= 3 || isValidQuizSessionToken(arr[3], bookId))
        && (arr.size() <= 4 || isValidQuizSessionToken(arr[4], bookId))
        && (arr.size() <= 5 || isValidQuizSessionToken(arr[5], bookId))
        && (arr.size() <= 6 || isValidQuizSessionToken(arr[6], bookId))
        && (arr.size() <= 7 || isValidQuizSessionToken(arr[7], bookId))
        && (arr.size() <= 8 || isValidQuizSessionToken(arr[8], bookId))
        && (arr.size() <= 9 || isValidQuizSessionToken(arr[9], bookId))
        && (arr.size() <= 10 || isValidQuizSessionToken(arr[10], bookId))
        && (arr.size() <= 11 || isValidQuizSessionToken(arr[11], bookId))
        && (arr.size() <= 12 || isValidQuizSessionToken(arr[12], bookId))
        && (arr.size() <= 13 || isValidQuizSessionToken(arr[13], bookId))
        && (arr.size() <= 14 || isValidQuizSessionToken(arr[14], bookId));
    }

    function isValidQuizHistoryBatchB(arr, bookId) {
      return (arr.size() <= 15 || isValidQuizSessionToken(arr[15], bookId))
        && (arr.size() <= 16 || isValidQuizSessionToken(arr[16], bookId))
        && (arr.size() <= 17 || isValidQuizSessionToken(arr[17], bookId))
        && (arr.size() <= 18 || isValidQuizSessionToken(arr[18], bookId))
        && (arr.size() <= 19 || isValidQuizSessionToken(arr[19], bookId))
        && (arr.size() <= 20 || isValidQuizSessionToken(arr[20], bookId))
        && (arr.size() <= 21 || isValidQuizSessionToken(arr[21], bookId))
        && (arr.size() <= 22 || isValidQuizSessionToken(arr[22], bookId))
        && (arr.size() <= 23 || isValidQuizSessionToken(arr[23], bookId))
        && (arr.size() <= 24 || isValidQuizSessionToken(arr[24], bookId))
        && (arr.size() <= 25 || isValidQuizSessionToken(arr[25], bookId))
        && (arr.size() <= 26 || isValidQuizSessionToken(arr[26], bookId))
        && (arr.size() <= 27 || isValidQuizSessionToken(arr[27], bookId))
        && (arr.size() <= 28 || isValidQuizSessionToken(arr[28], bookId))
        && (arr.size() <= 29 || isValidQuizSessionToken(arr[29], bookId));
    }

    function isValidQuizHistorySessions(arr, bookId) {
      return arr is list
        && arr.size() <= 30
        && arr.toSet().size() == arr.size()
        && isValidQuizHistoryBatchA(arr, bookId)
        && isValidQuizHistoryBatchB(arr, bookId);
    }

    // Standalone Validation Blueprint for UserProfile (safe for create, owner update, and superadmin role update)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'avatarUrl', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && isValidDisplayName(data)
        && isValidEmailField(data)
        && isValidAvatarUrl(data)
        && isValidRoleField(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for BunpouBookProgress
    function isValidBunpouProgress(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && isValidBunpouList(data.mastered, bookId)
        && isValidBunpouList(data.hard, bookId)
        && data.mastered.toSet().intersection(data.hard.toSet()).size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for KotobaBookProgress
    function isValidKotobaProgress(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && isValidKotobaList(data.mastered, bookId)
        && isValidKotobaList(data.hard, bookId)
        && data.mastered.toSet().intersection(data.hard.toSet()).size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for DailyStudyTracker
    function isValidDailyTracker(data) {
      return data.keys().hasAll(['uid', 'dailyGoal', 'days', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dailyGoal', 'days', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.dailyGoal is int
        && data.dailyGoal in [3, 5, 10, 15]
        && isValidDailyDaysList(data.days)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for BunpouQuizHistory
    function isValidBunpouQuizHistory(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'sessions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'sessions', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && isValidQuizHistorySessions(data.sessions, bookId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for LiveActivity (includes real-time live quiz inspection fields)
    function isValidLiveActivity(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'avatarUrl', 'role',
          'status', 'activeTab', 'activeBookId', 'moduleLabel',
          'quizInProgress', 'quizMode', 'quizBookId',
          'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount',
          'totalMasteredBunpou', 'totalMasteredKotoba', 'totalMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizSummary',
          'currentStreak', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'avatarUrl', 'role',
          'status', 'activeTab', 'activeBookId', 'moduleLabel',
          'quizInProgress', 'quizMode', 'quizBookId',
          'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount',
          'quizFromChapter', 'quizToChapter', 'quizPatternId', 'quizExampleIndex',
          'quizChoiceIds', 'quizSelectedChoiceId', 'quizAnswerCorrect', 'quizLiveAnswers',
          'totalMasteredBunpou', 'totalMasteredKotoba', 'totalMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizSummary',
          'currentStreak', 'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && isOwnAuthEmail(data)
        && isValidAvatarUrl(data)
        && isValidRole(data.role)
        && data.status is string && data.status in ['browsing', 'studying', 'quizzing', 'idle']
        && data.activeTab is string && data.activeTab in ['flashcard', 'kotoba', 'list', 'quiz', 'info', 'admin']
        && isValidBookId(data.activeBookId)
        && data.moduleLabel is string && data.moduleLabel.size() <= 80
        && data.quizInProgress is bool
        && data.quizMode is string && data.quizMode in ['', 'meaning', 'cloze', 'pattern']
        && data.quizBookId is string && data.quizBookId in ['', 'n5', 'n4']
        && data.quizCurrentQuestion is int && data.quizCurrentQuestion >= 0 && data.quizCurrentQuestion <= 50
        && data.quizTotalQuestions is int && data.quizTotalQuestions >= 0 && data.quizTotalQuestions <= 50
        && data.quizCorrectCount is int && data.quizCorrectCount >= 0 && data.quizCorrectCount <= 50
        && isValidLiveQuizDetailFields(data)
        && data.totalMasteredBunpou is int && data.totalMasteredBunpou >= 0 && data.totalMasteredBunpou <= 300
        && data.totalMasteredKotoba is int && data.totalMasteredKotoba >= 0 && data.totalMasteredKotoba <= 2000
        && data.totalMastered is int && data.totalMastered >= 0 && data.totalMastered <= 2300
        && data.totalQuizSessions is int && data.totalQuizSessions >= 0 && data.totalQuizSessions <= 5000
        && data.lastQuizScore is int && data.lastQuizScore >= -1 && data.lastQuizScore <= 100
        && data.lastQuizSummary is string && data.lastQuizSummary.size() <= 120
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 999
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for ActivityEvent
    function isValidActivityEvent(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'type', 'bookId',
          'title', 'detail', 'score', 'correctCount', 'totalQuestions', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'type', 'bookId',
          'title', 'detail', 'score', 'correctCount', 'totalQuestions', 'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && isOwnAuthEmail(data)
        && data.type is string && data.type in ['quiz_started', 'quiz_completed', 'progress_milestone']
        && isValidBookId(data.bookId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.detail is string && data.detail.size() <= 240
        && data.score is int && data.score >= -1 && data.score <= 100
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 50
        && data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 50
        && data.createdAt is timestamp;
    }

    // --- /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrAbove());

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && 'role' in incoming()
        && isOwnAuthEmail(incoming())
        && (
          (isBootstrapSuperAdmin() && incoming().role == 'superadmin')
          || (!isBootstrapSuperAdmin() && incoming().role == 'user')
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1a: Owner updates profile metadata without modifying role
          (
            isOwner(userId)
            && isOwnAuthEmail(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'email', 'updatedAt'])
            && (!('role' in existing()) || incoming().role == existing().role)
          )
          // Action 1b: Owner auto-heals missing legacy role (strictly 'user') or Bootstrap Superadmin self-heals 'superadmin'
          || (
            isOwner(userId)
            && isOwnAuthEmail(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'email', 'role', 'updatedAt'])
            && 'role' in incoming()
            && (
              (isBootstrapSuperAdmin() && incoming().role == 'superadmin')
              || (!('role' in existing()) && incoming().role == 'user')
            )
          )
          // Action 2: Superadmin updates ONLY ['role', 'updatedAt'] of another non-bootstrap user
          || (
            isSuperAdmin()
            && userId != request.auth.uid
            && !isTargetBootstrapSuperAdmin(existing())
            && 'role' in incoming()
            && isValidRole(incoming().role)
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          )
        );

      // Deny client-side profile deletion to prevent orphaned subcollections
      allow delete: if false;

      // --- /users/{userId}/bunpouProgress/{bookId} ---
      match /bunpouProgress/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidBookId(bookId)
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouProgress(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouProgress(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // --- /users/{userId}/kotobaProgress/{bookId} ---
      match /kotobaProgress/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidBookId(bookId)
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidKotobaProgress(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidKotobaProgress(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // --- /users/{userId}/dailyTracker/{trackerId} ---
      match /dailyTracker/{trackerId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && trackerId == 'state'
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && trackerId == 'state'
          && isValidDailyTracker(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && trackerId == 'state'
          && isValidDailyTracker(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['dailyGoal', 'days', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && trackerId == 'state'
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // --- /users/{userId}/quizHistory/{bookId} ---
      match /quizHistory/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidBookId(bookId)
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouQuizHistory(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouQuizHistory(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['sessions', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // --- /liveActivity/{userId} ---
    match /liveActivity/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrAbove());

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().updatedAt == request.time
        && matchesActualUserRole(incoming().role, userId);

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'avatarUrl', 'role',
          'status', 'activeTab', 'activeBookId', 'moduleLabel',
          'quizInProgress', 'quizMode', 'quizBookId',
          'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount',
          'quizFromChapter', 'quizToChapter', 'quizPatternId', 'quizExampleIndex',
          'quizChoiceIds', 'quizSelectedChoiceId', 'quizAnswerCorrect', 'quizLiveAnswers',
          'totalMasteredBunpou', 'totalMasteredKotoba', 'totalMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizSummary',
          'currentStreak', 'updatedAt'
        ])
        && matchesActualUserRole(incoming().role, userId);

      allow delete: if false;
    }

    // --- /activityEvents/{eventId} ---
    match /activityEvents/{eventId} {
      allow get: if isSignedIn()
        && isValidId(eventId)
        && (isAdminOrAbove() || existing().uid == request.auth.uid);

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(eventId)
        && isValidActivityEvent(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update, delete: if false;
    }
  }
}
